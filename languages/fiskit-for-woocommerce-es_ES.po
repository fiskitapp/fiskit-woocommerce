msgid_plural "%d invoices are being issued in the background."
msgstr[0] "Se está emitiendo %d factura en segundo plano."
msgstr[1] "Se están emitiendo %d facturas en segundo plano."

#. translators: %d: number of orders.
#: includes/class-fiskit-orders.php:449
#, php-format
msgid "%d order skipped: already invoiced or not paid."
msgid_plural "%d orders skipped: already invoiced or not paid."
msgstr[0] "Se salteó %d pedido: ya facturado o sin pagar."
