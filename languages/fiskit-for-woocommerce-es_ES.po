#: includes/class-fiskit-orders.php:620
#, php-format
msgid "Invoice %s"
msgstr "Factura %s"

#. translators: %s: letter A, B or C.
#: includes/class-fiskit-orders.php:622
#, php-format
msgid "Credit note %s"
msgstr "Nota de crédito %s"

#. translators: %s: letter A, B or C.
